<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>POEAltarRecognizer</AssemblyName>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="Tesseract.Drawing" Version="5.2.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="tessdata\eng.traineddata" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('tessdata\eng.traineddata')" />
  </ItemGroup>
  <Target Name="DownloadEnglishOcrData" BeforeTargets="BeforeBuild"
          Condition="!Exists('tessdata\eng.traineddata')">
    <MakeDir Directories="tessdata" />
    <DownloadFile
      SourceUrl="https://github.com/tesseract-ocr/tessdata_fast/raw/main/eng.traineddata"
      DestinationFile="tessdata\eng.traineddata" />
  </Target>
</Project>
