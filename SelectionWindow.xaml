<Window x:Class="PoeAltarGuard.SelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="#66000000"
        Topmost="True" ShowInTaskbar="False"
        Left="{x:Static SystemParameters.VirtualScreenLeft}"
        Top="{x:Static SystemParameters.VirtualScreenTop}"
        Width="{x:Static SystemParameters.VirtualScreenWidth}"
        Height="{x:Static SystemParameters.VirtualScreenHeight}"
        Cursor="Cross">
  <Canvas x:Name="Surface" MouseLeftButtonDown="OnDown" MouseMove="OnMove" MouseLeftButtonUp="OnUp">
    <TextBlock Canvas.Left="24" Canvas.Top="20" FontSize="22" FontWeight="Bold" Foreground="White"
               Text="Drag a box around the area where altar choices appear • Esc to cancel"/>
    <Rectangle x:Name="SelectionRect" Visibility="Collapsed" Stroke="#FFFF3030" StrokeThickness="3"
               Fill="#22FF0000"/>
  </Canvas>
</Window>
